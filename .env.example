# Vercel KV (Redis) - Requerido para produccion en Vercel
# Ve a tu proyecto en vercel.com > Storage > Create KV Database
# Luego conecta al proyecto y Vercel llenara estas variables automaticamente
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Contrasena del sistema (por defecto: ryr2024)
ADMIN_PASSWORD=ryr2024

# En desarrollo local NO necesitas estas variables
# El sistema usa memoria interna automaticamente
